<launch>

  <arg name="robot_name"          default="locobot"/>
  <arg name="target_object"       default="target_object"/>

  <!-- VLM agent args -->
  <!-- false = don't start the Ollama-backed agent at all; drive picks yourself:
       rosservice call /locobot/task/get_object "target_name: 'bottle'" -->
  <arg name="use_vlm_agent"       default="true"/>
  <arg name="vlm_model"           default="qwen3-vl:2b-instruct"/>
  <!-- 5 was sized for the old single-tool design (get_object alone did pick
       AND place, "call it again up to 3 times total" per the old prompt). Now
       get_object only holds — a full task needs get_object (itself sometimes
       taking several retries against real-world positioning misses),
       inspect_object, update_plan, and a final answer in the SAME budget.
       Live-measured 2026-10-07: get_object alone took 4 retries (5 steps) to
       land a single successful grasp, leaving zero budget for anything after
       it — raised accordingly. -->
  <arg name="max_agent_steps"     default="15"/>
  <arg name="grasp_min_interval_s" default="5.0"/>

  <!-- YOLO args -->
  <!-- Fine-tuned on this project's own 5 catalogued objects (bottle, tea_box,
       can_coke, ball, table), replacing the stock COCO-pretrained model's
       class-confusion (can/tea_box both "cell phone", the capsule getting no
       class at all, the table only ever guessable as "dining table").
       finetune1 (2026-10-02, 591 frames) covered the first 4; finetune2
       (2026-10-03, 1310 frames, mAP50 0.989/mAP50-95 0.984 overall on a
       held-out split — table itself scored mAP50-95 0.995, the best of the
       five) added the table, a separate retrain from the stock checkpoint
       rather than a resume (the detection head's output size is fixed per
       training run). This param used to be declared but never actually read
       by yolo_detection_node.py (and pointed at a directory, YOLO-3D, that
       doesn't exist — "YOLO3D", no hyphen, is the real one); both fixed
       together. See the yolo-finetune-dataset memory for how this was
       trained. Remaining gap: "person" is still not a trained class (no
       person model exists in this project's worlds). -->
  <arg name="yolo_model"          default="/home/adrana/th_ws/YOLO3D/yolo11s_locobot_finetune2.pt"/>
  <arg name="yolo_process_rate"   default="5.0"/>
  <!-- Empty by default: yolo_detection_node then derives its class filter
       automatically from every measured yolo_labels entry in
       config/objects.yaml (plus "person", always kept for obstacle safety —
       see that node's SCENE_CLASSES). Adding a graspable object now only
       needs an entry in the catalog. Pass an explicit list here only to
       test an ad hoc class the catalog doesn't have yet. -->
  <arg name="yolo_target_classes" default="[]"/>
  <arg name="yolo_conf_threshold" default="0.10"/>
  <arg name="yolo_publish_image"  default="true"/>

  <!-- ── YOLO 3D detection node ───────────────────────────────────────── -->
  <node
    pkg="locobot_prog"
    type="yolo_detection_node.py"
    name="yolo_detection"
    output="screen"
    ns="$(arg robot_name)">
    <param name="robot_name"     value="$(arg robot_name)"/>
    <param name="yolo_model"     value="$(arg yolo_model)"/>
    <param name="target_object"  value="$(arg target_object)"/>
    <param name="process_rate"   value="$(arg yolo_process_rate)"/>
    <param name="conf_threshold" value="$(arg yolo_conf_threshold)"/>
    <param name="publish_image"  value="$(arg yolo_publish_image)"/>
    <rosparam param="target_classes" subst_value="True">$(arg yolo_target_classes)</rosparam>
  </node>

  <!-- ── Detection shim: JSON detections_3d -> typed DetectionArray ───── -->
  <node
    pkg="locobot_prog"
    type="detection_shim.py"
    name="detection_shim"
    output="screen"
    ns="$(arg robot_name)">
    <param name="robot_name" value="$(arg robot_name)"/>
  </node>

  <!-- ── World model + task orchestrator (merged, one process) ────────── -->
  <node
    pkg="locobot_prog"
    type="world_model_node.py"
    name="world_model"
    output="screen"
    ns="$(arg robot_name)">
    <param name="robot_name"    value="$(arg robot_name)"/>
    <param name="target_object" value="$(arg target_object)"/>
  </node>

  <!-- ── Arm: the only MoveGroupCommander ──────────────────────────────── -->
  <node
    pkg="locobot_prog"
    type="arm_node.py"
    name="arm"
    output="screen"
    ns="$(arg robot_name)">
    <param name="robot_name" value="$(arg robot_name)"/>
  </node>

  <!-- ── Navigation: the only cmd_vel publisher ────────────────────────── -->
  <node
    pkg="locobot_prog"
    type="navigation_node.py"
    name="navigation"
    output="screen"
    ns="$(arg robot_name)">
    <param name="robot_name" value="$(arg robot_name)"/>
  </node>

  <!-- ── VLM agent: the thin VLM planning layer ────────────────────────── -->
  <node
    if="$(arg use_vlm_agent)"
    pkg="locobot_prog"
    type="vlm_agent_node.py"
    name="vlm_agent"
    output="screen"
    ns="$(arg robot_name)">
    <param name="robot_name"            value="$(arg robot_name)"/>
    <param name="target_object"         value="$(arg target_object)"/>
    <param name="vlm_model"             value="$(arg vlm_model)"/>
    <param name="max_steps"             value="$(arg max_agent_steps)"/>
    <param name="grasp_min_interval_s"  value="$(arg grasp_min_interval_s)"/>
  </node>

  <!-- ── Point camera toward table on startup ─────────────────────────── -->
  <!-- tilt=0.55 rad: more downward to see table at x~0.70 m              -->
  <!-- pan=0.0 rad: straight ahead                                         -->
  <node pkg="locobot_prog" type="set_camera_angle.py" name="set_camera_angle"
        output="screen" ns="$(arg robot_name)">
    <param name="pan"   value="0.0"/>
    <param name="tilt"  value="0.35"/>
    <param name="delay" value="4.0"/>
  </node>

</launch>
