<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="locobot_table_objects">

    <gravity>0 0 -9.81</gravity>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.87 0.92 0.98 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ── Lighting ────────────────────────────────────────────────────── -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- ── Ground plane ───────────────────────────────────────────────── -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- ── Gazebo GUI camera pose ─────────────────────────────────────── -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>1.5 -1.5 3.5 0 0.55 0.7</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- ── Room walls (give LIDAR enough geometry for ICP to converge) ──── -->
    <model name="wall_north">
      <static>true</static>
      <pose>3.0 5.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>10.0 0.2 2.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10.0 0.2 2.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>3.0 -3.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>10.0 0.2 2.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10.0 0.2 2.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>8.0 1.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 9.0 2.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 9.0 2.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-2.0 1.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 9.0 2.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 9.0 2.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════════════════════════
         TABLE  (0.6 m wide × 1.2 m long × 0.45 m tall, at x=4.0, y=2.0)
         The table top surface is at z = 0.45 m.
         The robot spawns at origin and can search towards the table.
         ══════════════════════════════════════════════════════════════════ -->
    <model name="table">
      <static>true</static>
      <pose>4.1 2.0 0 0 0 0</pose>

      <!-- Table top -->
      <link name="top">
        <pose>0 0 0.425 0 0 0</pose>
        <collision name="top_col">
          <geometry>
            <box><size>1.2 0.6 0.05</size></box>
          </geometry>
        </collision>
        <visual name="top_vis">
          <geometry>
            <box><size>1.2 0.6 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.55 0.35 0.15 1</ambient>
            <diffuse>0.65 0.42 0.18 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Leg front-left -->
      <link name="leg_fl">
        <pose>-0.55 -0.25 0.20 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.05 0.05 0.40</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.05 0.05 0.40</size></box></geometry>
          <material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.5 0.3 0.12 1</diffuse></material>
        </visual>
      </link>

      <!-- Leg front-right -->
      <link name="leg_fr">
        <pose>-0.55 0.25 0.20 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.05 0.05 0.40</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.05 0.05 0.40</size></box></geometry>
          <material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.5 0.3 0.12 1</diffuse></material>
        </visual>
      </link>

      <!-- Leg back-left -->
      <link name="leg_bl">
        <pose>0.55 -0.25 0.20 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.05 0.05 0.40</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.05 0.05 0.40</size></box></geometry>
          <material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.5 0.3 0.12 1</diffuse></material>
        </visual>
      </link>

      <!-- Leg back-right -->
      <link name="leg_br">
        <pose>0.55 0.25 0.20 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.05 0.05 0.40</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.05 0.05 0.40</size></box></geometry>
          <material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.5 0.3 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════════════════════════
         OBJECTS ON THE TABLE  (table top is at z = 0.45 m)
         ══════════════════════════════════════════════════════════════════ -->

    <!-- Bottle: inline cylinder so no model-DB download is needed.             -->
    <!-- Body: r=0.033 m, h=0.23 m.  Table top z=0.45, half-height=0.115 → z=0.565 -->
    <model name="bottle">
      <pose>4.0 1.9 0.565 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><cylinder><radius>0.033</radius><length>0.23</length></cylinder></geometry>
          <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.033</radius><length>0.23</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.55 0.1 1</ambient>
            <diffuse>0.15 0.7 0.15 1</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>0.5</mass>
          <inertia><ixx>5.2e-4</ixx><iyy>5.2e-4</iyy><izz>2.7e-5</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
      </link>
    </model>

    <!-- Wood cube A  (5 cm × 5 cm × 5 cm; centre at z = 0.475) -->
    <model name="wood_cube_a">
      <pose>4.2 2.1 0.475 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material>
            <ambient>0.6 0.3 0.05 1</ambient>
            <diffuse>0.7 0.4 0.08 1</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>4.2e-5</ixx><iyy>4.2e-5</iyy><izz>4.2e-5</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
      </link>
    </model>

    <!-- Wood cube B  (5 cm × 5 cm × 5 cm; offset slightly) -->
    <model name="wood_cube_b">
      <pose>4.2 1.85 0.475 0 0 0.4</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material>
            <ambient>0.55 0.28 0.04 1</ambient>
            <diffuse>0.65 0.38 0.07 1</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>4.2e-5</ixx><iyy>4.2e-5</iyy><izz>4.2e-5</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
      </link>
    </model>

    <!-- Ball  (radius 0.035 m; centre at z = 0.485) -->
    <model name="ball">
      <pose>4.0 2.15 0.485 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><sphere><radius>0.035</radius></sphere></geometry>
          <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><sphere><radius>0.035</radius></sphere></geometry>
          <material>
            <ambient>0.7 0.05 0.05 1</ambient>
            <diffuse>0.85 0.08 0.08 1</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>0.156</mass>
          <inertia><ixx>8.76e-5</ixx><iyy>8.76e-5</iyy><izz>8.76e-5</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
      </link>
    </model>

  </world>
</sdf>
