<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- LINK_PREFIX is the real URDF link namespace.  Confirmed from
       interbotix_xslocobot_descriptions (links are "$(arg robot_name)/<link>")
       and from locobot_motion_node.py which attaches to "locobot/ee_gripper_link"
       and touches "locobot/{left,right}_finger_link".  robot_name = locobot, so
       the prefix is "locobot" (NOT "locobot_wx250s", which is the robot_model). -->
  <xacro:property name="LINK_PREFIX" value="locobot"/>

  <gazebo>
    <plugin name="gazebo_grasp_fix" filename="libgazebo_grasp_fix.so">
      <arm>
        <arm_name>wx250s</arm_name>
        <palm_link>${LINK_PREFIX}/gripper_link</palm_link>
        <gripper_link>${LINK_PREFIX}/left_finger_link</gripper_link>
        <gripper_link>${LINK_PREFIX}/right_finger_link</gripper_link>
      </arm>
      <!-- release_tolerance = how far a finger must have slid AWAY from the
           object, along its own axis, before GazeboGraspFix drops the weld.
           Opening the jaws around the bottle's neck gives ~11 mm; holding gives
           ~0 (inward creep counts negative, the object sagging in the attach
           joint is across the axis), so 3 mm separates the two cleanly.
           NOTE this relies on a local patch to ~/th_ws/src/gazebo-pkgs
           (GazeboGraspFix.cpp, detach check; `git -C ~/th_ws/src/gazebo-pkgs
           diff`). Upstream compares only the LENGTHS of the contact-to-object-
           origin vectors; the bottle's origin is at its base, ~210 mm below a
           neck grip, and the opening moves the pads almost perpendicular to
           that, so the length changed ~1 mm and the weld never let go —
           measured live: bottle placed upright, jaws fully open, and the
           retreat still carried it off the table. A plain displacement metric
           released mid-carry instead (finger creep + sag in the soft joint). -->
      <forces_angle_tolerance>120</forces_angle_tolerance>
      <update_rate>20</update_rate>
      <grip_count_threshold>1</grip_count_threshold>
      <max_grip_count>8</max_grip_count>
      <release_tolerance>0.003</release_tolerance>
      <disable_collisions_on_attach>false</disable_collisions_on_attach>
    </plugin>
  </gazebo>

  <!-- High-friction, stiff-contact finger pads.  These <gazebo reference> blocks
       override the interbotix defaults WITHOUT touching interbotix files, and
       back up the grasp-fix plugin: even friction-only phases of the hold get
       ~5x more grip. -->
  <gazebo reference="${LINK_PREFIX}/left_finger_link">
    <mu1>5.0</mu1>
    <mu2>5.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.0</maxVel>
  </gazebo>
  <gazebo reference="${LINK_PREFIX}/right_finger_link">
    <mu1>5.0</mu1>
    <mu2>5.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.0</maxVel>
  </gazebo>
</robot>
